FROM llmops-base:cpu

COPY pyfiles/modelapi_app.py /app/pyfiles/modelapi_app.py

WORKDIR /app/pyfiles
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=600s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')"

CMD ["uvicorn", "modelapi_app:app", "--host", "0.0.0.0", "--port", "8000"]  