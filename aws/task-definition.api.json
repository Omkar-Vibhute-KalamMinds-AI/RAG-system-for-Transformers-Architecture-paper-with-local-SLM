{
  "family": "llmops-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "4096",
  "memory": "16384",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "X86_64"
  },
  "executionRoleArn": "arn:aws:iam::123456789012:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::123456789012:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "123456789012.dkr.ecr.us-east-1.amazonaws.com/llmops-api:latest",
      "essential": true,
      "portMappings": [
        {
          "name": "api",
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        { "name": "LLMOPS_CONFIG", "value": "config.docker.yaml" },
        { "name": "GEMMA_MODEL_PATH", "value": "/models/llm" },
        { "name": "EMBED_MODEL_PATH", "value": "/models/embed" },
        { "name": "LANCEDB_PATH", "value": "/data/lance_db" },
        { "name": "LANCEDB_TABLE", "value": "transformer_table" },
        { "name": "LOG_DIR", "value": "/app/logs" },
        { "name": "PYTHONUNBUFFERED", "value": "1" }
      ],
      "mountPoints": [
        {
          "sourceVolume": "models-llm",
          "containerPath": "/models/llm",
          "readOnly": true
        },
        {
          "sourceVolume": "models-embed",
          "containerPath": "/models/embed",
          "readOnly": true
        },
        {
          "sourceVolume": "lance-db",
          "containerPath": "/data/lance_db",
          "readOnly": false
        },
        {
          "sourceVolume": "app-logs",
          "containerPath": "/app/logs",
          "readOnly": false
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')\" || exit 1"
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 600
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/llmops-api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "api",
          "awslogs-create-group": "true"
        }
      }
    }
  ],
  "volumes": [
    {
      "name": "models-llm",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-xxxxxxxx",
        "rootDirectory": "/models/llm",
        "transitEncryption": "ENABLED"
      }
    },
    {
      "name": "models-embed",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-xxxxxxxx",
        "rootDirectory": "/models/embed",
        "transitEncryption": "ENABLED"
      }
    },
    {
      "name": "lance-db",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-xxxxxxxx",
        "rootDirectory": "/data/lance_db",
        "transitEncryption": "ENABLED"
      }
    },
    {
      "name": "app-logs",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-xxxxxxxx",
        "rootDirectory": "/app/logs",
        "transitEncryption": "ENABLED"
      }
    }
  ]
}
